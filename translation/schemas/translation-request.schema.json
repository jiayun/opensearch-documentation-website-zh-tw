{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zh-tw-translation-request/v1",
  "type": "object",
  "required": [
    "schema",
    "metadata",
    "segments",
    "previous_issues"
  ],
  "properties": {
    "schema": {
      "const": "zh-tw-translation-request/v1"
    },
    "metadata": {
      "type": "object",
      "required": [
        "page",
        "source_sha256",
        "baseline_commit",
        "target_language",
        "chunk",
        "chunks",
        "prompt_version"
      ],
      "properties": {
        "page": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_commit": {
          "type": "string"
        },
        "target_language": {
          "const": "zh-TW"
        },
        "chunk": {
          "type": "integer",
          "minimum": 0
        },
        "chunks": {
          "type": "integer",
          "minimum": 1
        },
        "page_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": "string"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(fm(\\.[A-Za-z0-9_-]+)+|body\\.\\d{3})$"
          },
          "kind": {
            "enum": [
              "front_matter",
              "markdown"
            ]
          },
          "text": {
            "type": "string",
            "description": "Source text; protected regions are replaced by placeholders such as ⟦P12⟧."
          }
        }
      }
    },
    "previous_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
